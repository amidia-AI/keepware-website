# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SITE_URL: Public base URL of this site. Used for the post-payment redirect.
SITE_URL="http://localhost:3000"

# ---- Lemon Squeezy (payments) ----
# 1. Create a store + product at https://app.lemonsqueezy.com
# 2. LEMONSQUEEZY_API_KEY: Settings > API > create API key (use a TEST key locally)
LEMONSQUEEZY_API_KEY=""
# 3. LEMONSQUEEZY_WEBHOOK_SECRET: Settings > Webhooks > add webhook pointing to
#    https://YOUR-PUBLIC-HOST/api/webhook (localhost is not reachable by Lemon
#    Squeezy — use a tunnel like ngrok/cloudflared for local testing), then copy
#    the signing secret here.
LEMONSQUEEZY_WEBHOOK_SECRET=""
# 4. LEMONSQUEEZY_VARIANT_ID (optional): Product > Variants > ID (e.g. "123456").
#    If empty, checkout charges the catalog price (TYPEMASTER_APP.priceUsd) as a
#    custom-price checkout.
LEMONSQUEEZY_VARIANT_ID=""
# 5. LEMONSQUEEZY_TEST_MODE: "true" when using a test-mode API key, "false" for live.
LEMONSQUEEZY_TEST_MODE="true"
